{
  "name": "brewcompetition-cli",
  "version": "1.1.0",
  "description": "Brew Competition - CLI to fetch medal earners and various homebrew competition metadata.",
  "keywords": [
    "homebrew",
    "beer",
    "competition",
    "medals",
    "brewing",
    "bjcp",
    "bcoem",
    "reggie",
    "bap",
    "cli",
    "results",
    "awards",
    "oclif"
  ],
  "homepage": "https://github.com/tmack8001/brewcompetition-cli",
  "bugs": "https://github.com/tmack8001/brewcompetition-cli/issues",
  "repository": "tmack8001/brewcompetition-cli",
  "license": "MIT",
  "author": "Trevor Mack @tmack8001",
  "type": "module",
  "exports": "./lib/index.js",
  "main": "",
  "types": "dist/index.d.ts",
  "bin": {
    "brewcompetition": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b",
    "changelog": "sh scripts/prepare-changelog.sh",
    "install-hooks": "sh scripts/install-hooks.sh",
    "lint": "eslint .",
    "prepack": "yarn build && oclif manifest && oclif readme",
    "postpack": "node -e \"require('node:fs').rmSync('oclif.manifest.json',{force:true})\"",
    "prepare": "yarn build",
    "release": "sh scripts/release.sh",
    "smoke:install": "node scripts/smoke-install.mjs",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "posttest": "yarn lint",
    "version": "oclif readme && git add README.md CHANGELOG.md",
    "postversion": "echo 'Version updated. Push with: git push origin main --tags'"
  },
  "oclif": {
    "bin": "brewcompetition",
    "commands": "./dist/commands",
    "dirname": "brewcompetition",
    "topicSeparator": " ",
    "topics": {
      "medals": {
        "description": "fetch medals from a specific homebrew competition"
      },
      "competitions": {
        "description": "fetch metadata (entry status, entry deadlines, drop off window, awards, etc) from a specific homebrew competition"
      }
    }
  },
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "impit": "^0.14.7",
    "moment-timezone": "^0.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.2.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "chai": "^6.3.0",
    "domhandler": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-config-oclif": "^7.1.10",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "oclif": "^4.24.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
